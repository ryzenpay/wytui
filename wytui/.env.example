# Database (REQUIRED - Replace [CHANGE_ME] with a strong password)
DATABASE_URL="postgresql://postgres:[CHANGE_ME]@db:5432/wytui?schema=public"

# Auth.js (REQUIRED - Generate with: openssl rand -hex 32)
AUTH_SECRET="[CHANGE_ME]"
AUTH_TRUST_HOST="true"

# OIDC (Optional - leave empty to disable)
OIDC_ISSUER_URL=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_DISPLAY_NAME="SSO"

# Application
NODE_ENV="development"
DOWNLOADS_PATH="/downloads"
