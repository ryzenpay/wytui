# Database connection (REQUIRED)
# Replace [CHANGE_ME] with a strong password
DATABASE_URL=postgresql://postgres:[CHANGE_ME]@localhost:5432/wytui?schema=public

# Authentication secret (REQUIRED)
# Generate with: openssl rand -hex 32
AUTH_SECRET=[CHANGE_ME]

# Application settings
AUTH_TRUST_HOST=true
ORIGIN=http://localhost:3000
NODE_ENV=development

# Auto-create admin user, skipping the setup wizard (optional)
# ADMIN_USERNAME=admin@example.com
# ADMIN_PASSWORD=[CHANGE_ME]

# OIDC (optional)
# OIDC_ISSUER_URL=https://your-provider.com
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_DISPLAY_NAME=SSO
